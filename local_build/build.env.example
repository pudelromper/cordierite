# Cordierite local release pipeline configuration.
# Copy to /etc/cordierite/build.env (or local_build/build.env) and edit.
# Everything here can also be set as an environment variable.

# Registry and namespace the images are pushed to. The image reference baked
# into the OS is ${CORDIERITE_REGISTRY}/${CORDIERITE_VENDOR}/<image>.
#   GHCR:        CORDIERITE_REGISTRY=ghcr.io        CORDIERITE_VENDOR=pudelromper
#   self-hosted: CORDIERITE_REGISTRY=registry.poodle.internal:5000  CORDIERITE_VENDOR=cordierite
CORDIERITE_REGISTRY=ghcr.io
CORDIERITE_VENDOR=pudelromper

# Images to build, space separated. Targets and kernels are derived from the name.
CORDIERITE_IMAGES="cordierite cordierite-deck cordierite-nvidia cordierite-nvidia-open"

# Update track: stable, testing or unstable. Defaults to the checked-out git
# branch (main -> stable).
#CORDIERITE_BRANCH=main

# Fedora release and kernel pins default to the CI matrix in
# .github/workflows/build.yml so there is a single source of truth.
#FEDORA_VERSION=44
#KERNEL_FLAVOR=ogc
#KERNEL_VERSION=7.2.4-ogc3.1.fc44
#KERNEL_FLAVOR_LTS=ogc-lts
#KERNEL_VERSION_LTS=6.18.49-ogc1.1.fc44

# cosign private key that pairs with cosign.pub in the repository root.
# The password comes from COSIGN_PASSWORD (or COSIGN_PASSWORD_FILE).
COSIGN_KEY=/etc/cordierite/cosign.key
#COSIGN_PASSWORD_FILE=/etc/cordierite/cosign.password

# GitHub token used only for API calls during the build (release asset
# lookups). Optional; without it the unauthenticated rate limit applies.
#GITHUB_TOKEN=

# Registry credentials are not stored here: run `podman login <registry>`
# once as the user the pipeline runs as (root for the systemd units), or
# point REGISTRY_AUTH_FILE at an auth.json.
#REGISTRY_AUTH_FILE=/etc/cordierite/auth.json

# Scratch and output locations. Rechunking needs roughly the image size
# again in free space here.
CORDIERITE_STATE_DIR=/var/lib/cordierite
#CORDIERITE_ISO_DIR=/var/lib/cordierite/iso

# ISO options
#CORDIERITE_BUILD_ISO=1          # release.sh also builds ISOs after the images
#EMBED_FLATPAKS=0                # 1 embeds installer/kde_flatpaks into the ISO
#RCLONE_REMOTE=b2:cordierite-releases/releases   # upload ISOs here (rclone must be configured)
#TITANOBOA_REPO=https://github.com/Zeglius/titanoboa
#TITANOBOA_REF=revamp-pr

# Skip the goss smoke tests (they need goss + dgoss on the build box).
#CORDIERITE_SKIP_TESTS=1

# Build without pushing/signing, useful for a first dry run.
#CORDIERITE_NO_PUSH=1

# Pull the checked-out branch before a scheduled release.
#CORDIERITE_GIT_PULL=1
